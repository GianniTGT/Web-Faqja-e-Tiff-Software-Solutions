---
import { PRODUCTS } from '../data/site.js';

/** Our own products, as cards. Used on the home page and on /work/. */
interface Props { lang: 'en' | 'de'; }
const { lang } = Astro.props;
const STATUS = {
  en: { live: 'In use', building: 'In development', internal: 'Own tool' },
  de: { live: 'Im Einsatz', building: 'In Entwicklung', internal: 'Eigenes Werkzeug' },
}[lang];
---
<div class="products">
  {PRODUCTS.map((p) => (
    <article class={`product p-${p.id}`}>
      <div class="p-top">
        <span class="p-kind">{p[lang].kind}</span>
        <span class={`tag tag-${p.status}`}>{STATUS[p.status]}</span>
      </div>
      <h3>{p.name}</h3>
      <p>{p[lang].line}</p>
      {p.href && <a class="p-link" href={p.href}>{p.href.replace('https://', '')} &rarr;</a>}
    </article>
  ))}
</div>

<style>
  .products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
  }
  .product {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 24px 24px 22px;
    overflow: hidden;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .product::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(90deg, var(--forest), var(--gold));
    opacity: .85;
  }
  .product:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: transparent; }
  .p-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .p-kind { font-size: 13px; color: var(--muted); font-weight: 500; }
  .product h3 { margin: 0; font-size: 21px; }
  .product p { margin: 0; color: var(--muted); font-size: 15.5px; text-wrap: pretty; flex: 1; }
  .p-link { font-size: 14.5px; font-weight: 600; text-decoration: none; color: var(--forest); }
  .p-link:hover { text-decoration: underline; }
  .tag {
    font-family: var(--display);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .04em;
    padding: 4px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .tag-live { background: color-mix(in srgb, var(--forest) 13%, transparent); color: var(--forest); }
  .tag-building { background: color-mix(in srgb, var(--gold) 22%, transparent); color: var(--gold-text); }
  .tag-internal { background: var(--surface-2); color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .product, .product:hover { transition: none; transform: none; } }
</style>
