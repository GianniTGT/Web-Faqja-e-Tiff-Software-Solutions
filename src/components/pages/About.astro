---
import Page from '../../layouts/Page.astro';
import { SITE } from '../../data/site.js';
import Team from '../Team.astro';
import { localise } from '../../i18n/ui.js';

/**
 * About, in both languages.
 *
 * Short on biography and long on how the work is done, because a small firm is bought on
 * judgement rather than on a CV.
 *
 * **The voice is "we", on Gianni's instruction of 30 August 2026.** The page used to say
 * "One developer, in Bern" and speak in the first person singular throughout. A small
 * company is what he wants read here — not how many people it is.
 *
 * **Two things here are Gianni's to confirm rather than mine to assert:** the languages
 * listed, and nothing else. They are written plainly so a correction is a one-word edit.
 */
interface Props { lang: 'en' | 'de'; }
const { lang } = Astro.props;

const LANGUAGES = { en: ['English', 'German', 'Albanian'], de: ['Deutsch', 'Englisch', 'Albanisch'] };

const COPY = {
  en: {
    meta: {
      title: `A Small Software Company in ${SITE.city} — ${SITE.name}`,
      description: `${SITE.name} is a small software company in ${SITE.city}, ` +
                   `${SITE.country}, building desktop applications, websites and the systems that join them.`,
    },
    eyebrow: 'About',
    h1: 'A small company, in Bern.',
    lede: `${SITE.person} worked for years as an IT developer and helped many businesses take their work digital. Today he and his small team in Bern build software and websites for SMEs and industry.`,
    sections: [
      { h: 'What we do', p: [
        'We build the software a business runs on, and the website in front of it. And we keep looking after both.',
      ]},
      { h: 'How we charge', p: [
        'A fixed price for a clear job, agreed in advance. Care and hosting as a fixed monthly fee, cancellable any time.',
      ], quiet: 'The accounts, the domains and the code are yours.' },
    ],
    detailsLabel: 'Details',
    rows: [['Based in', `${SITE.city}, ${SITE.country}`], ['Working in', null],
           ['Clients in', 'All over the world'], ['Email', null]],
    teamEyebrow: 'Team',
    teamTitle: 'Who does what.',
    beliefEyebrow: 'How we work',
    beliefTitle: 'Three things that do not change.',
    beliefs: [
      { title: 'Tested before we say so', body: 'We only say it works once we have used it ourselves.' },
      { title: 'Everything written down', body: 'Every decision is recorded, so nobody has to guess.' },
      { title: 'Small and personal', body: 'Whoever built your system answers your questions.' },
    ],
    closeTitle: 'Worth a conversation?',
    closeLede: 'The first one costs nothing and is usually the most useful part of the project.',
    closeCta: 'Get in touch',
  },

  de: {
    meta: {
      title: 'Softwarefirma in Bern — Tiff Software Solutions',
      description: 'Tiff Software Solutions ist ein kleines Softwareunternehmen in Bern. ' +
                   'Desktop-Anwendungen, Websites und die Systeme dazwischen.',
    },
    eyebrow: 'Über uns',
    h1: 'Ein kleines Unternehmen, in Bern.',
    lede: 'Kani Tifeki hat jahrelang als IT-Entwickler gearbeitet und vielen Betrieben geholfen, ihre Abläufe digital zu machen. Heute baut er mit seinem kleinen Team in Bern Software und Websites für KMU und Industrie.',
    sections: [
      { h: 'Was wir tun', p: [
        'Wir bauen die Software, mit der ein Betrieb arbeitet, und die Website davor. Und wir betreuen beides weiter.',
      ]},
      { h: 'Wie wir abrechnen', p: [
        'Festpreis für klare Aufträge, vorher vereinbart. Betreuung und Hosting als feste Monatspauschale, jederzeit kündbar.',
      ], quiet: 'Konten, Domains und Code gehören Ihnen.' },
    ],
    detailsLabel: 'Angaben',
    rows: [['Sitz', 'Bern, Schweiz'], ['Sprachen', null],
           ['Kunden in', 'aller Welt'], ['E-Mail', null]],
    teamEyebrow: 'Team',
    teamTitle: 'Wer was macht.',
    beliefEyebrow: 'Wie wir arbeiten',
    beliefTitle: 'Drei Dinge, die sich nicht ändern.',
    beliefs: [
      { title: 'Erst testen, dann sagen', body: 'Wir sagen erst, dass etwas läuft, wenn wir es selbst bedient haben.' },
      { title: 'Alles dokumentiert', body: 'Jede Entscheidung ist aufgeschrieben, damit niemand raten muss.' },
      { title: 'Klein und persönlich', body: 'Wer Ihr System gebaut hat, beantwortet auch Ihre Fragen.' },
    ],
    closeTitle: 'Ein Gespräch wert?',
    closeLede: 'Das erste kostet nichts und ist meistens der nützlichste Teil des Projekts.',
    closeCta: 'Kontakt aufnehmen',
  },
};

const c = COPY[lang];
const href = (p) => localise(p, lang);
const languages = LANGUAGES[lang];
---
<Page title={c.meta.title} description={c.meta.description}>
  <section class="head">
    <div class="wrap">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </section>

  <section class="section team-sec">
    <div class="wrap">
      <p class="eyebrow">{c.teamEyebrow}</p>
      <h2 style="margin-bottom:28px">{c.teamTitle}</h2>
      <Team lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="wrap layout">
      <div class="prose">
        {c.sections.map((s) => (
          <>
            <h2>{s.h}</h2>
            {s.p.map((para) => <p>{para}</p>)}
            {s.quiet && <p class="quiet">{s.quiet}</p>}
          </>
        ))}
      </div>

      <aside class="side" aria-label={c.detailsLabel}>
        <dl>
          {c.rows.map(([k, v], i) => (
            <div>
              <dt>{k}</dt>
              <dd>
                {i === 1 && languages.join(', ')}
                {i === 3 && <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
                {v}
              </dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{c.beliefEyebrow}</p>
      <h2>{c.beliefTitle}</h2>
      <div class="cols" style="margin-top:30px">
        {c.beliefs.map((b) => (
          <article class="card">
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>{c.closeTitle}</h2>
          <p class="lede">{c.closeLede}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href={href('/contact/')}>{c.closeCta}</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .head {
    padding-block: clamp(48px, 8vw, 88px) clamp(20px, 3vw, 30px);
    background:
      radial-gradient(110% 80% at 8% -10%,
        color-mix(in srgb, var(--forest) 9%, transparent), transparent 60%),
      var(--paper);
  }
  .head h1 { max-width: 13ch; }

  .layout {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 44px;
    align-items: start;
  }
  .layout h2:not(:first-child) { margin-top: 36px; }

  .side {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 24px 26px;
    position: sticky;
    top: 88px;
  }
  .side dl { margin: 0; display: grid; gap: 17px; }
  .side dt {
    font-family: var(--display);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .side dd { margin: 0; font-size: 15.5px; color: var(--ink); word-break: break-word; }

  .band {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(28px, 4vw, 44px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
  }
  .band h2 { margin-bottom: 10px; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: 30px; }
    .side { position: static; }
  }
</style>
