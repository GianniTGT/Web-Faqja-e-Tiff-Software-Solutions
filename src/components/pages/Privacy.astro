---
import Page from '../../layouts/Page.astro';
import { SITE } from '../../data/site.js';
import { localise } from '../../i18n/ui.js';

/**
 * Privacy, in both languages.
 *
 * **This page is short because the site genuinely does very little**, and every claim on
 * it is checkable against the built output: no analytics, no cookies, no form, and the
 * typefaces are served from this domain, so a visit makes **no request to any third party
 * at all**.
 *
 * That last one is the reason `Base.astro` self-hosts the fonts. Keep this page and that
 * decision together: the day somebody adds a Google Fonts link, a map embed or a video
 * player, the sentence below stops being true and this page becomes a false statement.
 */
interface Props { lang: 'en' | 'de'; }
const { lang } = Astro.props;

const COPY = {
  en: {
    meta: { title: `Privacy — ${SITE.name}`,
            description: 'No cookies, no analytics, no third-party requests. What this site ' +
                         'collects, which is almost nothing.' },
    eyebrow: 'Privacy',
    h1: 'Almost nothing, and here is exactly what.',
    lede: 'A short page, because this is a short answer. Every line below is a statement ' +
          'about how the site is built, not a promise about how it is used.',
    claims: [
      { q: 'Does this site use cookies?',
        a: 'No. It sets no cookies and stores nothing in your browser. That is also why there is no cookie banner — there is nothing to ask you about.' },
      { q: 'Is there analytics or tracking?',
        a: 'No. No analytics, no tag manager, no advertising pixel, no session recording. I do not know which pages you looked at.' },
      { q: 'Does anything load from another company?',
        a: 'No. The typefaces are served from this domain rather than from Google, so opening a page here does not send your address to anybody else. There are no embedded maps, fonts, videos or scripts from third parties.' },
      { q: 'What about the server?',
        a: 'The hosting provider keeps ordinary web-server logs — your IP address, the page requested, the time, your browser — for a short period, for security and to keep the server running. That is technically necessary and it is not used to build a profile of you.' },
    ],
    emailH: 'If you email me',
    email: 'Your message and your address sit in my mailbox, and I use them to answer you and ' +
      'to carry on the conversation if there is one. They are not added to a mailing list, ' +
      'not passed to anybody, and not sold. Ask me to delete the correspondence and I will.',
    rightsH: 'Your rights',
    rightsBefore: 'You can ask what I hold about you, ask for it to be corrected, or ask for ' +
      'it to be deleted. Write to',
    rightsAfter: ' and you will get an answer from a person. There is no form and no ticket number.',
    changeH: 'If this changes',
    change: 'The day this site gains analytics, a contact form or anything embedded from ' +
      'another company, this page changes in the same commit. It is part of the site, not a ' +
      'document filed away from it.',
    whoH: 'Who is responsible',
    whoBefore: `${SITE.person}, ${SITE.city}, ${SITE.country} — the full details are on the`,
    whoLink: 'imprint',
  },

  de: {
    meta: { title: 'Datenschutz — Tiff Software Solutions',
            description: 'Keine Cookies, keine Statistik, keine Anfragen an Dritte. Was diese ' +
                         'Website erhebt — nämlich fast nichts.' },
    eyebrow: 'Datenschutz',
    h1: 'Fast nichts — und hier steht genau was.',
    lede: 'Eine kurze Seite, weil die Antwort kurz ist. Jede Zeile unten ist eine Aussage ' +
          'darüber, wie diese Website gebaut ist, kein Versprechen über ihre Nutzung.',
    claims: [
      { q: 'Verwendet diese Website Cookies?',
        a: 'Nein. Sie setzt keine Cookies und speichert nichts in Ihrem Browser. Deshalb gibt es auch kein Cookie-Banner — es gibt nichts, wozu wir Sie fragen müssten.' },
      { q: 'Gibt es Statistik oder Tracking?',
        a: 'Nein. Keine Webstatistik, kein Tag Manager, kein Werbepixel, keine Sitzungsaufzeichnung. Ich weiss nicht, welche Seiten Sie angesehen haben.' },
      { q: 'Wird etwas von einer anderen Firma geladen?',
        a: 'Nein. Die Schriften werden von dieser Domain ausgeliefert und nicht von Google — eine Seite hier zu öffnen schickt Ihre Adresse also an niemanden sonst. Es gibt keine eingebetteten Karten, Schriften, Videos oder Skripte von Dritten.' },
      { q: 'Und der Server?',
        a: 'Der Hoster führt gewöhnliche Server-Protokolle — Ihre IP-Adresse, die aufgerufene Seite, die Zeit, Ihren Browser — für kurze Zeit, zur Sicherheit und zum Betrieb. Das ist technisch notwendig und wird nicht verwendet, um ein Profil von Ihnen anzulegen.' },
    ],
    emailH: 'Wenn Sie mir schreiben',
    email: 'Ihre Nachricht und Ihre Adresse liegen in meinem Postfach, und ich verwende sie, ' +
      'um Ihnen zu antworten und das Gespräch fortzuführen, falls es eines gibt. Sie kommen ' +
      'auf keine Verteilerliste, werden an niemanden weitergegeben und nicht verkauft. Bitten ' +
      'Sie mich, den Schriftwechsel zu löschen, und ich tue es.',
    rightsH: 'Ihre Rechte',
    rightsBefore: 'Sie können fragen, was ich über Sie gespeichert habe, eine Berichtigung ' +
      'verlangen oder die Löschung. Schreiben Sie an',
    rightsAfter: ', und Sie bekommen eine Antwort von einem Menschen. Kein Formular, keine Ticketnummer.',
    changeH: 'Wenn sich das ändert',
    change: 'An dem Tag, an dem diese Website Statistik, ein Kontaktformular oder irgendetwas ' +
      'von einer anderen Firma Eingebettetes bekommt, ändert sich diese Seite im selben ' +
      'Commit. Sie ist Teil der Website, kein Dokument, das daneben abgelegt wird.',
    whoH: 'Verantwortlich',
    whoBefore: 'Kani Tifeki, Bern, Schweiz — die vollständigen Angaben stehen im',
    whoLink: 'Impressum',
  },
};

const c = COPY[lang];
---
<Page title={c.meta.title} description={c.meta.description}>
  <section class="wrap page">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.h1}</h1>
    <p class="lede">{c.lede}</p>

    <div class="qa">
      {c.claims.map((claim) => (
        <div class="row">
          <h2>{claim.q}</h2>
          <p>{claim.a}</p>
        </div>
      ))}
    </div>

    <div class="prose block">
      <h2>{c.emailH}</h2>
      <p>{c.email}</p>

      <h2>{c.rightsH}</h2>
      <p>{c.rightsBefore} <a href={`mailto:${SITE.email}`}>{SITE.email}</a>{c.rightsAfter}</p>

      <h2>{c.changeH}</h2>
      <p class="quiet">{c.change}</p>

      <h2>{c.whoH}</h2>
      <p class="quiet">
        {c.whoBefore} <a href={localise('/imprint/', lang)}>{c.whoLink}</a>.
      </p>
    </div>
  </section>
</Page>

<style>
  .page { padding-block: clamp(48px, 8vw, 88px) 0; }

  .qa { margin-top: 40px; display: grid; gap: 2px; }
  /* Rules rather than cards: four short answers in four boxes would look like a pricing
     table, and this is a page somebody reads straight down. */
  .row {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 30px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .row:last-child { border-bottom: 1px solid var(--line); }
  .row h2 { font-size: 18px; margin: 0; }
  .row p { margin: 0; color: var(--muted); font-size: 16.5px; text-wrap: pretty; }

  .block { margin-top: 44px; }
  .block h2 { font-size: 20px; margin: 32px 0 10px; }
  .block h2:first-child { margin-top: 0; }
  .quiet { color: var(--muted); }

  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
