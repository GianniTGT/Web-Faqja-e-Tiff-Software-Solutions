---
import Page from '../../layouts/Page.astro';
import { SITE, PREISE } from '../../data/site.js';
import { localise } from '../../i18n/ui.js';
import ProductShowcase from '../ProductShowcase.astro';

/**
 * Services, in both languages. Short on purpose (Sara, 12 October 2026: too much text):
 * one tile per service, one line each. Prices come from `PREISE` in `src/data/site.js`.
 *
 * German is Sie-Form and carries no `ß`; see `src/i18n/ui.js`.
 */
interface Props { lang: 'en' | 'de'; }
const { lang } = Astro.props;

const COPY = {
  en: {
    meta: {
      title: `Software & Web Development — ${SITE.name}`,
      description: `Software, websites, hosting from CHF ${PREISE.betreuung} a month, SEO, Google Ads, email setup and training — from one place in Bern.`,
    },
    eyebrow: 'Services',
    h1: 'Everything from one place.',
    lede: 'Software, websites and everything around them. From Bern.',
    softTitle: 'Our software',
    hostTitle: 'Website care and hosting',
    hostFrom: 'from CHF',
    hostPer: 'a month',
    hostItems: ['Updates and daily backups', 'Monitoring of site and email', 'Small changes included', 'Server space included'],
    trainTitle: 'Training',
    trainLine: `2 hours, once: CHF ${PREISE.schulung}`,
    groups: [
      { title: 'Software', items: [
        ['Desktop software', 'Windows applications that hold your real records.'],
        ['Web apps and subscriptions', 'Software in the browser, on every device.'],
        ['Android apps', 'Apps for staff and customers.'],
        ['Integrations', 'AutoScout24, bank files, Excel import.'],
      ] },
      { title: 'Web', items: [
        ['Websites', 'Hand-built or WordPress, fast on the phone.'],
        ['Design and logo', 'A look that is yours, not a template.'],
        ['Hosting move', 'We move your site without downtime.'],
        ['Domains and DNS', 'Set up correctly, in your name.'],
      ] },
      { title: 'Visibility', items: [
        ['SEO', 'Found on Google: Search Console, sitemap, structured data.'],
        ['Google Ads', 'Ads that bring enquiries, not just clicks.'],
        ['Google Business Profile', 'Your entry on Maps, kept up to date.'],
        ['Reviews', 'Answer reviews, correct wrong details.'],
      ] },
      { title: 'Operations', items: [
        ['Email setup', 'MX, SPF, DKIM, DMARC — so mail arrives.'],
        ['Backups', 'Stored away from the server they protect.'],
        ['Data transfer', 'Customers and articles from Excel.'],
        ['Support', 'You talk to the people who built it.'],
      ] },
    ],
    closeTitle: 'Not sure what you need?',
    closeLede: 'Write to us. The first conversation is free.',
    closeCta: 'Get in touch',
  },
  de: {
    meta: {
      title: 'Software- und Webentwicklung Bern — Tiff Software Solutions',
      description: `Software, Websites, Hosting ab CHF ${PREISE.betreuung} im Monat, SEO, Google Ads, E-Mail einrichten und Schulung — alles aus einer Hand, aus Bern.`,
    },
    eyebrow: 'Leistungen',
    h1: 'Alles aus einer Hand.',
    lede: 'Software, Websites und alles drumherum. Aus Bern.',
    softTitle: 'Unsere Software',
    hostTitle: 'Website-Betreuung und Hosting',
    hostFrom: 'ab CHF',
    hostPer: 'pro Monat',
    hostItems: ['Updates und tägliche Sicherung', 'Überwachung von Website und E-Mail', 'Kleine Änderungen inklusive', 'Serverplatz inklusive'],
    trainTitle: 'Schulung',
    trainLine: `2 Stunden, einmalig: CHF ${PREISE.schulung}`,
    groups: [
      { title: 'Software', items: [
        ['Desktop-Software', 'Windows-Programme, die Ihre echten Daten halten.'],
        ['Web-Apps und Abos', 'Software im Browser, auf jedem Gerät.'],
        ['Android-Apps', 'Apps für Mitarbeitende und Kunden.'],
        ['Schnittstellen', 'AutoScout24, Bankdateien, Excel-Import.'],
      ] },
      { title: 'Web', items: [
        ['Websites', 'Von Hand gebaut oder WordPress, schnell auf dem Handy.'],
        ['Design und Logo', 'Ein Auftritt, der Ihrer ist, keine Vorlage.'],
        ['Hosting-Umzug', 'Wir ziehen Ihre Website ohne Ausfall um.'],
        ['Domains und DNS', 'Richtig eingerichtet, auf Ihren Namen.'],
      ] },
      { title: 'Sichtbarkeit', items: [
        ['SEO', 'Bei Google gefunden: Search Console, Sitemap, strukturierte Daten.'],
        ['Google Ads', 'Anzeigen, die Anfragen bringen, nicht nur Klicks.'],
        ['Google-Firmeneintrag', 'Ihr Eintrag auf Maps, immer aktuell.'],
        ['Bewertungen', 'Bewertungen beantworten, falsche Angaben korrigieren.'],
      ] },
      { title: 'Betrieb', items: [
        ['E-Mail einrichten', 'MX, SPF, DKIM, DMARC — damit Mails ankommen.'],
        ['Sicherungen', 'Ausserhalb des Servers, den sie schützen.'],
        ['Datenübernahme', 'Kunden und Artikel aus Excel.'],
        ['Support', 'Sie sprechen mit den Leuten, die es gebaut haben.'],
      ] },
    ],
    closeTitle: 'Nicht sicher, was Sie brauchen?',
    closeLede: 'Schreiben Sie uns. Das erste Gespräch kostet nichts.',
    closeCta: 'Kontakt aufnehmen',
  },
};

const c = COPY[lang];
const href = (p) => localise(p, lang);
---
<Page title={c.meta.title} description={c.meta.description}>
  <section class="head">
    <div class="wrap">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </section>

  <section class="section-tight" id="software">
    <div class="wrap">
      <h2 class="gruppe">{c.softTitle}</h2>
      <ProductShowcase lang={lang} />
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap angebot">
      <div class="stuetze host" id="hosting">
        <p class="eyebrow">{c.hostTitle}</p>
        <p class="gross"><span>{c.hostFrom}</span> {PREISE.betreuung}<small>{c.hostPer}</small></p>
        <ul class="support-liste">
          {c.hostItems.map((t) => <li><b>{t}</b></li>)}
        </ul>
        <a class="btn btn-gold" href={href('/contact/')}>{c.closeCta}</a>
      </div>
      <div class="card schulung" id="schulung">
        <p class="eyebrow">{c.trainTitle}</p>
        <h2>{c.trainLine}</h2>
      </div>
    </div>
  </section>

  {c.groups.map((g) => (
    <section class="section-tight">
      <div class="wrap">
        <h2 class="gruppe">{g.title}</h2>
        <div class="kacheln">
          {g.items.map(([t, d]) => (
            <article class="card">
              <h3>{t}</h3>
              <p>{d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section-tight">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>{c.closeTitle}</h2>
          <p class="lede">{c.closeLede}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-gold" href={href('/contact/')}>{c.closeCta}</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .head {
    padding-block: clamp(48px, 8vw, 88px) clamp(12px, 2vw, 20px);
    background:
      radial-gradient(110% 80% at 8% -10%,
        color-mix(in srgb, var(--forest) 9%, transparent), transparent 60%),
      var(--paper);
  }
  .head h1 { max-width: 14ch; }
  .angebot { display: grid; grid-template-columns: 1.6fr 1fr; gap: 20px; align-items: stretch; }
  .host .gross { margin: 6px 0 0; font-family: var(--display); font-size: clamp(48px, 7vw, 72px); font-weight: 700; color: #fff; line-height: 1; letter-spacing: -0.03em; }
  .host .gross span { font-size: 20px; color: #F0C871; letter-spacing: 0; }
  .host .gross small { display: block; margin-top: 8px; font-size: 15px; font-weight: 500; color: rgba(255, 255, 255, .75); letter-spacing: 0; }
  .host .support-liste { grid-template-columns: repeat(2, 1fr); }
  .schulung { display: flex; flex-direction: column; justify-content: center; }
  .schulung h2 { margin: 0; }
  .gruppe { margin: 0 0 18px; }
  .kacheln { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .kacheln h3 { margin: 0 0 6px; }
  .band {
    position: relative; overflow: hidden;
    background: radial-gradient(60% 120% at 100% 0%, rgba(201, 160, 83, .25), transparent 60%), linear-gradient(135deg, var(--forest-deep), #0A3A22);
    border-radius: var(--r-lg); padding: clamp(30px, 4.5vw, 52px);
    display: flex; align-items: center; justify-content: space-between; gap: 30px; flex-wrap: wrap; color: #fff;
  }
  .band h2 { margin-bottom: 10px; color: #fff; }
  .band .lede { color: rgba(255, 255, 255, .8); }
  @media (max-width: 1000px) {
    .angebot { grid-template-columns: 1fr; }
    .kacheln { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .kacheln, .host .support-liste { grid-template-columns: 1fr; }
  }
</style>
