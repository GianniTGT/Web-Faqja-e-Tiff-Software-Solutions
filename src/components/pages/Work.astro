---
import Page from '../../layouts/Page.astro';
import { SITE, OTHER_WORK } from '../../data/site.js';
import { localise } from '../../i18n/ui.js';

/**
 * The case study, in both languages.
 *
 * One project told properly rather than six thumbnails. A small firm's portfolio has one
 * shape worth showing: depth. Everything here happened; where a thing is not finished it
 * says so.
 *
 * **The dealership is named, since 30 August 2026.** It was "a used-car dealership in
 * Anchorage, Alaska" until Gianni confirmed he had Tif's permission. Putting a customer's
 * name on a public page is theirs to give, and it was given.
 *
 * Named where the customer is *identified* — the lede, the glance card, the meta
 * description — and not in the twenty sentences that go on to say "the dealership". Swapping
 * every one for the proper noun would read like a press release; a name works once.
 */
interface Props { lang: 'en' | 'de'; }
const { lang } = Astro.props;

const COPY = {
  en: {
    meta: {
      title: `Work — ${SITE.name}`,
      description: 'Tiff Cardealer: a Windows application and a website for Downtown Auto ' +
                   'Sales in Anchorage, Alaska, and the decisions that shaped both.',
    },
    eyebrow: 'Case study',
    h1: 'Tiff Cardealer',
    lede: 'Downtown Auto Sales, a used-car dealership in Anchorage, Alaska, buys damaged ' +
          'cars, repairs them and sells them. This is the system it runs on — and the ' +
          'product it became.',
    problemTitle: 'The problem',
    problem: [
      'The dealership had a website full of vehicles and a set of spreadsheets full of money, and no connection between them. Every car was typed twice: once into the office record with what it cost to buy and repair, and once into the website with what it was being sold for. A car that sold on Tuesday was still on the website on Friday.',
      'The obvious fix — put everything in one online system — was the wrong one, for a reason that decided the whole architecture. The office record holds what each car cost, what was spent fixing it, and what the margin is. Some of that must never be visible to the staff selling the cars, and none of it should sit on a shared server because it was convenient.',
    ],
    builtTitle: 'What was built',
    built: 'Two halves that meet at exactly one point. A Windows application on the office ' +
           'machine holds everything. A website shows only what a customer should see. The ' +
           'seam between them is a one-way push of a fixed list of public fields.',
    glance: 'At a glance',
    glanceRows: [
      ['Client', 'Downtown Auto Sales, Anchorage, Alaska'],
      ['Role', 'Everything — architecture, code, design, hosting'],
      ['Desktop', 'Electron, React, encrypted SQLite'],
      ['Web', 'WordPress theme written from scratch'],
      ['Documents', 'Generated PDFs, drawn to the real forms'],
      ['Now', 'In daily use, and sold to other dealerships'],
    ],
    decEyebrow: 'The decisions',
    decTitle: 'Four that shaped everything after them.',
    decisions: [
      { title: 'The money never leaves the building',
        body: 'Purchase price, parts, labour, margin and the negotiated sale price stay in an encrypted database on the dealership\u2019s own machine. What goes to the website is built from a list of allowed fields — so a column added next year cannot leak by being forgotten. It is enforced in three places and the build fails if the test that proves it does.' },
      { title: 'The office is the source of truth',
        body: 'A car is marked sold on the lot, and the record is written and committed before anything is sent anywhere. If the website is unreachable, the sale still happened and the push is retried later. A dealership\u2019s till must not wait on somebody else\u2019s server.' },
      { title: 'Roles are data, not decoration',
        body: 'The sales manager sees every car and no cost. That is not a hidden column in the interface — the rows he receives have never contained the figures, so there is nothing on his screen to reveal.' },
      { title: 'A dead end is a defect',
        body: 'Every failure says which link broke and what to do about it: the site did not answer, the certificate is not trusted, the password was refused, this account may not publish. \u201CConnection failed\u201D is not usable by anybody standing on a lot in Anchorage.' },
    ],
    officeEyebrow: 'In the office',
    officeTitle: 'The application',
    desktop: [
      'Intake with the VIN decoded live, and the specification filled in from it',
      'Costs entered as they happen, with profit and margin recalculating as you type',
      'Photographs taken on a phone, or imported from the camera roll in a batch',
      'Bill of Sale, federal odometer disclosure and FTC Buyers Guide, numbered and reprintable',
      'Money still owed after a part payment, with a reminder before the date',
      'A calendar of what happened and what is due, and reports on where the profit came from',
      'Encrypted backups, verified by reopening the copy rather than by trusting the write',
    ],
    webEyebrow: 'On the lot\u2019s website',
    webTitle: 'The theme',
    web: [
      'Inventory with search and filters built from the cars actually on the lot',
      'Vehicle pages with a photo gallery that swipes on a phone with no JavaScript at all',
      'Financing enquiries that never ask for a social security number, and say so',
      'Leads stored in the database before any email is attempted',
      'Which vehicles get looked at, counted without a cookie and without counting staff',
    ],
    standsTitle: 'Where it stands',
    stands: [
      'The application is in daily use. Vehicles publish and unpublish by themselves, the documents print from the record, and the whole thing opens on a morning when the internet does not.',
      'The website is finished and waiting on one thing that is not code: the day the domain is pointed at it. That is a decision for the owner, taken on a quiet day with a backup in hand — not something to slip in beside a release.',
    ],
    standsQuiet: 'The system started as one dealership\u2019s office tool and is now a product. ' +
      'Nothing about that dealership — no name, no address, no logo — exists anywhere in the ' +
      'code; it all lives in a profile the owner fills in on first run. That is what lets the ' +
      'same application run for the next dealership without a line being changed.',
    otherEyebrow: 'Also built',
    otherTitle: 'Other work, in one line each.',
    closeTitle: 'Something in your business works like this.',
    closeLede: 'Typed twice, or held in a spreadsheet nobody else can open. Tell us what it is.',
    closeCta: 'Get in touch',
  },

  de: {
    meta: {
      title: 'Referenzen — Tiff Software Solutions',
      description: 'Tiff Cardealer: eine Windows-Anwendung und eine Website für Downtown ' +
                   'Auto Sales in Anchorage, Alaska — und die Entscheidungen dahinter.',
    },
    eyebrow: 'Fallstudie',
    h1: 'Tiff Cardealer',
    lede: 'Downtown Auto Sales, ein Gebrauchtwagenhändler in Anchorage, Alaska, kauft ' +
          'beschädigte Fahrzeuge, repariert sie und verkauft sie. Das ist das System, mit ' +
          'dem der Betrieb arbeitet — und das Produkt, das daraus wurde.',
    problemTitle: 'Das Problem',
    problem: [
      'Der Händler hatte eine Website voller Fahrzeuge und Tabellen voller Zahlen, und dazwischen keine Verbindung. Jedes Auto wurde zweimal erfasst: einmal im Büro mit Einkaufs- und Reparaturkosten, einmal auf der Website mit dem Verkaufspreis. Ein Auto, das am Dienstag verkauft wurde, stand am Freitag noch online.',
      'Die naheliegende Lösung — alles in ein Online-System — war die falsche, und der Grund dafür hat die ganze Architektur bestimmt. Der Bürodatensatz enthält, was jedes Auto gekostet hat, was die Reparatur gekostet hat und wie hoch die Marge ist. Ein Teil davon darf für die Verkäufer nie sichtbar sein, und nichts davon gehört auf einen geteilten Server, nur weil es bequem wäre.',
    ],
    builtTitle: 'Was gebaut wurde',
    built: 'Zwei Hälften, die sich an genau einem Punkt treffen. Eine Windows-Anwendung auf ' +
           'dem Bürorechner hält alles. Eine Website zeigt nur, was ein Kunde sehen soll. Die ' +
           'Naht dazwischen ist eine Einbahnübertragung einer festen Liste öffentlicher Felder.',
    glance: 'Auf einen Blick',
    glanceRows: [
      ['Kunde', 'Downtown Auto Sales, Anchorage, Alaska'],
      ['Rolle', 'Alles — Architektur, Code, Gestaltung, Hosting'],
      ['Desktop', 'Electron, React, verschlüsseltes SQLite'],
      ['Web', 'Von Grund auf geschriebenes WordPress-Theme'],
      ['Dokumente', 'Erzeugte PDFs, den echten Formularen nachgebaut'],
      ['Heute', 'Täglich im Einsatz und an weitere Händler verkauft'],
    ],
    decEyebrow: 'Die Entscheidungen',
    decTitle: 'Vier, die alles Weitere bestimmt haben.',
    decisions: [
      { title: 'Das Geld verlässt das Haus nicht',
        body: 'Einkaufspreis, Teile, Arbeit, Marge und der ausgehandelte Verkaufspreis bleiben in einer verschlüsselten Datenbank auf dem Rechner des Händlers. Was zur Website geht, wird aus einer Liste erlaubter Felder gebaut — eine nächstes Jahr ergänzte Spalte kann also nicht dadurch nach aussen gelangen, dass jemand sie vergisst. Es ist an drei Stellen durchgesetzt, und der Build schlägt fehl, wenn der Test das nicht bestätigt.' },
      { title: 'Das Büro ist die Wahrheit',
        body: 'Ein Auto wird auf dem Platz als verkauft markiert, und der Datensatz wird geschrieben und festgeschrieben, bevor irgendetwas irgendwohin geht. Ist die Website nicht erreichbar, hat der Verkauf trotzdem stattgefunden und die Übertragung wird später wiederholt. Die Kasse eines Händlers darf nicht auf den Server eines anderen warten.' },
      { title: 'Rollen sind Daten, keine Dekoration',
        body: 'Der Verkaufsleiter sieht jedes Auto und keine Kosten. Das ist keine ausgeblendete Spalte in der Oberfläche — die Datensätze, die er bekommt, haben die Zahlen nie enthalten. Auf seinem Bildschirm gibt es nichts aufzudecken.' },
      { title: 'Eine Sackgasse ist ein Fehler',
        body: 'Jeder Fehlschlag sagt, welches Glied gebrochen ist und was zu tun ist: die Seite hat nicht geantwortet, dem Zertifikat wird nicht vertraut, das Passwort wurde abgelehnt, dieses Konto darf nicht veröffentlichen. Mit \u201EVerbindung fehlgeschlagen\u201C kann niemand etwas anfangen, der auf einem Platz in Anchorage steht.' },
    ],
    officeEyebrow: 'Im Büro',
    officeTitle: 'Die Anwendung',
    desktop: [
      'Erfassung mit sofort entschlüsselter Fahrgestellnummer, aus der die Ausstattung gefüllt wird',
      'Kosten werden erfasst, wenn sie anfallen; Gewinn und Marge rechnen beim Tippen mit',
      'Fotos mit dem Handy aufgenommen oder als Stapel aus der Galerie übernommen',
      'Kaufvertrag, Kilometerstandserklärung und FTC Buyers Guide, nummeriert und nachdruckbar',
      'Offener Restbetrag nach einer Teilzahlung, mit Erinnerung vor dem Termin',
      'Ein Kalender dessen, was war und was ansteht, und Auswertungen, woher der Gewinn kam',
      'Verschlüsselte Sicherungen, geprüft durch erneutes Öffnen der Kopie statt durch Vertrauen',
    ],
    webEyebrow: 'Auf der Website des Händlers',
    webTitle: 'Das Theme',
    web: [
      'Bestand mit Suche und Filtern, gebaut aus den Fahrzeugen, die wirklich auf dem Platz stehen',
      'Fahrzeugseiten mit einer Fotogalerie, die auf dem Handy wischt — ganz ohne JavaScript',
      'Finanzierungsanfragen, die nie nach einer Sozialversicherungsnummer fragen, und das auch sagen',
      'Anfragen werden in der Datenbank gespeichert, bevor eine E-Mail versucht wird',
      'Welche Fahrzeuge angeschaut werden, gezählt ohne Cookie und ohne das Personal mitzuzählen',
    ],
    standsTitle: 'Wo es steht',
    stands: [
      'Die Anwendung ist täglich im Einsatz. Fahrzeuge erscheinen und verschwinden von selbst, die Dokumente drucken aus dem Datensatz, und das Ganze öffnet sich an einem Morgen, an dem das Internet es nicht tut.',
      'Die Website ist fertig und wartet auf eine einzige Sache, die kein Code ist: den Tag, an dem die Domain darauf zeigt. Das ist eine Entscheidung des Inhabers, getroffen an einem ruhigen Tag mit einer Sicherung in der Hand — nichts, das man nebenbei einschiebt.',
    ],
    standsQuiet: 'Das System begann als Bürowerkzeug eines einzigen Händlers und ist heute ein ' +
      'Produkt. Nichts über diesen Händler — kein Name, keine Adresse, kein Logo — steht ' +
      'irgendwo im Code; alles liegt in einem Profil, das der Inhaber beim ersten Start ' +
      'ausfüllt. Genau das lässt dieselbe Anwendung beim nächsten Händler laufen, ohne dass ' +
      'eine Zeile geändert wird.',
    otherEyebrow: 'Ausserdem gebaut',
    otherTitle: 'Weitere Arbeiten, je eine Zeile.',
    closeTitle: 'Irgendetwas in Ihrem Betrieb läuft genauso.',
    closeLede: 'Zweimal getippt, oder in einer Tabelle, die sonst niemand öffnen kann. ' +
               'Erzählen Sie uns, was es ist.',
    closeCta: 'Kontakt aufnehmen',
  },
};

const c = COPY[lang];
const href = (p) => localise(p, lang);
---
<Page title={c.meta.title} description={c.meta.description}>
  <section class="head">
    <div class="wrap">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap layout">
      <div class="prose">
        <h2>{c.problemTitle}</h2>
        {c.problem.map((para) => <p>{para}</p>)}
        <h2>{c.builtTitle}</h2>
        <p>{c.built}</p>
      </div>

      <aside class="side" aria-label={c.glance}>
        <dl>
          {c.glanceRows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{c.decEyebrow}</p>
      <h2>{c.decTitle}</h2>
      <div class="cols dec">
        {c.decisions.map((d) => (
          <article class="card">
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <p class="eyebrow">{c.officeEyebrow}</p>
        <h2>{c.officeTitle}</h2>
        <ul class="ticks">{c.desktop.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">{c.webEyebrow}</p>
        <h2>{c.webTitle}</h2>
        <ul class="ticks">{c.web.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prose">
        <h2>{c.standsTitle}</h2>
        {c.stands.map((para) => <p>{para}</p>)}
        <p class="quiet">{c.standsQuiet}</p>
      </div>
    </div>
  </section>

  {OTHER_WORK.length > 0 && (
    <section class="section">
      <div class="wrap">
        <p class="eyebrow">{c.otherEyebrow}</p>
        <h2>{c.otherTitle}</h2>
        <ul class="others">
          {OTHER_WORK.map((o) => (
            <li>
              <strong>{o.href ? <a href={o.href}>{o.name}</a> : o.name}</strong>
              <span>{o[lang]}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section-tight">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>{c.closeTitle}</h2>
          <p class="lede">{c.closeLede}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href={href('/contact/')}>{c.closeCta}</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .head {
    padding-block: clamp(48px, 8vw, 88px) clamp(20px, 3vw, 30px);
    background:
      radial-gradient(110% 80% at 8% -10%,
        color-mix(in srgb, var(--forest) 9%, transparent), transparent 60%),
      var(--paper);
  }

  .layout {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 44px;
    align-items: start;
  }
  .layout h2:not(:first-child) { margin-top: 34px; }

  .side {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 24px 26px;
    position: sticky;
    top: 88px;
  }
  .side dl { margin: 0; display: grid; gap: 17px; }
  .side dt {
    font-family: var(--display);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .side dd { margin: 0; font-size: 15.5px; color: var(--ink); }

  /* Four decisions, explicit tracks — `auto-fit` leaves the fourth card alone on a row
     of its own, which reads as a broken block rather than as a grid. */
  .dec { margin-top: 30px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1040px) { .dec { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px)  { .dec { grid-template-columns: 1fr; } }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; }
  .ticks { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 12px; }
  .ticks li {
    position: relative;
    padding-left: 26px;
    font-size: 16.5px;
    color: var(--ink);
    text-wrap: pretty;
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 9px;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--gold);
  }

  .others {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .others li {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 26px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }
  .others li:last-child { border-bottom: 1px solid var(--line); }
  .others strong { font-family: var(--display); font-weight: 600; font-size: 17px; }
  .others span { color: var(--muted); font-size: 16px; text-wrap: pretty; }
  @media (max-width: 760px) {
    .others li { grid-template-columns: 1fr; gap: 6px; }
  }

  .band {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(28px, 4vw, 44px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
  }
  .band h2 { margin-bottom: 10px; }

  @media (max-width: 900px) {
    .layout, .two { grid-template-columns: 1fr; gap: 30px; }
    /* Sticky is a desktop affordance. In one column it would pin a card above the text it
       belongs to and put its own bottom out of reach. */
    .side { position: static; }
  }
</style>
