---
/**
 * The Tiff monogram: a T with a road curving up through it, on a forest tile.
 *
 * Drawn rather than loaded as a file so it takes the page's own colours and stays sharp
 * at any size. The real brand artwork lives in the DAS-Manager repo under `assets/` and
 * `build/`; when the full lockup is needed on this site it comes from there rather than
 * being redrawn.
 */
interface Props { size?: number; }
const { size = 34 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect width="32" height="32" rx="7.5" fill="var(--forest)" />
  <path d="M8 9.6h16M16 9.6V24" stroke="#fff" stroke-width="2.7" stroke-linecap="round" />
  <path d="M13.2 24c0-4.6 1.4-7.8 5.4-9.8" stroke="var(--gold)" stroke-width="2.3" stroke-linecap="round" />
</svg>
