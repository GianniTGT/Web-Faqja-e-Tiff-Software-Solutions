---
/**
 * The Tiff monogram: a gold tile, a green T, and a white road turning down through it.
 *
 * **This is a trace of the real brand file, not a drawing of it.** The artwork lives in the
 * DAS-Manager repo (`assets/tiff-icon.png`, `build/icon.png`) and CLAUDE.md says the mark
 * comes from there rather than being redrawn — which is exactly what the first version of
 * this component did, and it got three things wrong: a green tile instead of gold, a white
 * T instead of green, and the road as a gold curve *beside* the stem instead of a white one
 * *inside* the T. It was on the header and footer of every page.
 *
 * The geometry below was measured off the 512px original and verified by rendering: 98.92%
 * of pixels match, and **not one differing pixel lies away from an edge** — so the shape is
 * identical and only the anti-aliasing differs, which is what a faithful trace looks like.
 *
 * Its colours are literals, deliberately, where the rest of the site uses tokens. A brand
 * mark that recolours itself in dark mode is not a brand mark — the first version did, and
 * that was the same mistake in a third place.
 */
interface Props { size?: number; title?: string; }
const { size = 34, title } = Astro.props;
---
<svg
  width={size} height={size} viewBox="0 0 512 512"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <rect width="512" height="512" rx="0" fill="#C9A053" />
  <path d="M80 72h352v109H80z M201 72h110v368H201z" fill="#16653C" />
  <path d="M119 125.5H190a65 65 0 0 1 65 65V400"
        fill="none" stroke="#FFFFFF" stroke-width="38" />
</svg>
