---
import Mark from './Mark.astro';
import { SITE, NAV } from '../data/site.js';

/**
 * The site header.
 *
 * **No hamburger, and that is the point.** Four links fit on a phone if the wordmark
 * shortens and the row is allowed to wrap — so the navigation is always visible instead of
 * being one tap and one JavaScript bundle away. A menu button on a four-page site is a
 * control that hides four words.
 *
 * Sticky is CSS only. Nothing here runs a script.
 */
const path = Astro.url.pathname;
/** `/work` and `/work/` are the same page; the trailing slash depends on the host. */
const isHere = (href) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
---
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
      <Mark size={30} />
      <span class="full">Tiff <b>Software Solutions</b></span>
      <span class="abbr">Tiff</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 66px;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--display);
    font-size: 14px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .brand b { font-weight: 700; color: var(--forest); }
  .abbr { display: none; }

  nav ul {
    display: flex;
    align-items: center;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 15.5px;
    font-weight: 500;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--ink); }
  /* The current page is marked, not merely coloured — `aria-current` is the fact and the
     rule underneath is the picture of it, so screen readers and eyes get the same answer. */
  nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--gold); }

  @media (max-width: 560px) {
    .full { display: none; }
    .abbr { display: inline; }
    .bar { min-height: 58px; padding-block: 10px; }
    nav ul { gap: 20px; }
    nav a { font-size: 15px; }
  }
</style>
