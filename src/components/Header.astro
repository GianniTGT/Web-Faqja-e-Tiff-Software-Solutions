---
import Mark from './Mark.astro';
import { SITE } from '../data/site.js';
import { NAV, UI, localise, localeFromPath, otherLocaleHref } from '../i18n/ui.js';

/**
 * The site header.
 *
 * **No hamburger, and that is the point.** Four links and a language switch fit on a phone
 * if the wordmark shortens and the row is allowed to wrap — so the navigation is always
 * visible instead of being one tap and one JavaScript bundle away. The competitor this was
 * measured against hides five links behind a button on a 1500px desktop screen; a menu
 * button on a four-page site is a control that hides four words.
 *
 * Sticky is CSS only. Nothing here runs a script.
 */
const path = Astro.url.pathname;
const lang = localeFromPath(path);
const t = UI[lang];

/** `/work` and `/work/` are the same page; the trailing slash depends on the host. */
const strip = (h) => h.replace(/\/$/, '');
const isHere = (href) => strip(path) === strip(localise(href, lang));
---
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href={localise('/', lang)} aria-label={`${SITE.name} — ${t.home}`}>
      <Mark size={30} />
      <span class="full">Tiff <b>Software Solutions</b></span>
      <span class="abbr">Tiff</span>
    </a>

    <div class="right">
      <nav aria-label={t.mainNav}>
        <ul>
          {NAV.map((item) => (
            <li>
              <a
                href={localise(item.href, lang)}
                aria-current={isHere(item.href) ? 'page' : undefined}
              >
                {item[lang]}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* The switch names the language it goes TO, in that language — "Auf Deutsch" on the
          English page. A flag would be wrong twice over: German is not Germany, and
          Switzerland has four national languages. */}
      <a class="lang" href={otherLocaleHref(path, lang)} lang={lang === 'en' ? 'de' : 'en'}
         aria-label={t.switchLabel}>
        {t.switchTo}
      </a>
    </div>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 66px;
    flex-wrap: wrap;
  }
  .right { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--display);
    font-size: 14px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .brand b { font-weight: 700; color: var(--forest); }
  .abbr { display: none; }

  nav ul {
    display: flex;
    align-items: center;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 15.5px;
    font-weight: 500;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--ink); }
  /* The current page is marked, not merely coloured — `aria-current` is the fact and the
     rule underneath is the picture of it, so screen readers and eyes get the same answer. */
  nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--gold); }

  .lang {
    font-family: var(--display);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--forest);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 13px;
    white-space: nowrap;
  }
  .lang:hover { border-color: var(--forest); background: var(--surface); }

  @media (max-width: 640px) {
    .full { display: none; }
    .abbr { display: inline; }
    .bar { min-height: 58px; padding-block: 10px; }
    .right { gap: 16px; }
    nav ul { gap: 18px; }
    nav a { font-size: 15px; }
    .lang { font-size: 12px; padding: 4px 11px; }
  }
</style>
