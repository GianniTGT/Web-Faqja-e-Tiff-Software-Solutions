---
/**
 * The typefaces are **served from this site, not from Google**, and that is a decision
 * rather than a preference.
 *
 * A `<link>` to fonts.googleapis.com sends every visitor's IP address to Google before a
 * word is on the screen. On a site whose whole argument is that a business's data stays
 * where it belongs — and one selling into Switzerland, where that transfer is a live legal
 * question — borrowing a font that way would contradict the page it is setting.
 *
 * It is also faster. No DNS lookup, no TLS handshake to a third party, no render-blocking
 * request that can be slow on a bad connection; the woff2 files are hashed and cached with
 * everything else. The `latin-ext` subsets are here for the accents German and Albanian
 * need — `unicode-range` means a browser fetches them only if the page actually uses one.
 *
 * Only the weights the design uses are imported. Pulling a whole family for two weights is
 * how a page ends up shipping half a megabyte of type nobody reads.
 */
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/poppins/latin-ext-600.css';
import '@fontsource/poppins/latin-ext-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-sans/latin-ext-500.css';
import '@fontsource/ibm-plex-sans/latin-ext-600.css';
import '@fontsource/ibm-plex-mono/latin-500.css';

import '../styles/tokens.css';
import { SITE } from '../data/site.js';
import { UI, localeFromPath, otherLocaleHref } from '../i18n/ui.js';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

/* The canonical URL is built from `site` in astro.config.mjs. If that is wrong, every
   canonical on the site is wrong and nothing warns — which is why the config carries a
   note saying to change it the day the domain is bought. */
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const lang = localeFromPath(path);
const t = UI[lang];

/**
 * `hreflang` tells a search engine these two URLs are the same page in two languages,
 * rather than two pages competing with each other for the same query. Each page names
 * both itself and its counterpart — the pair has to be symmetrical or Google ignores it —
 * plus `x-default` for a reader whose language is neither.
 */
const alternates = [
  ['en', new URL(lang === 'en' ? path : otherLocaleHref(path, lang), Astro.site).href],
  ['de', new URL(lang === 'de' ? path : otherLocaleHref(path, lang), Astro.site).href],
];

/**
 * The sharing card. One image per language rather than one per page: it carries the mark,
 * the wordmark, the home page's headline and the domain, so it is true on every page of
 * its language and cannot go stale when one page's words change.
 *
 * **Two cards, because the site is two sites.** A German page sharing an English card is
 * the same fault as a German page with an English title — and `/de/` is the half a Berner
 * SME reads. Generated from the real logo and the real typefaces by `scripts/make-og.mjs`,
 * which is why they are committed files rather than a build step.
 *
 * **Served from this domain, like the fonts.** A card pulled from an image CDN would be a
 * third-party request, and `/privacy/` says there are none.
 */
const ogImage = new URL(lang === 'de' ? '/og-de.png' : '/og.png', Astro.site);

/**
 * Structured data: what a search engine is told, in machine-readable form, that the prose
 * only implies. It is the difference between Google inferring "some website" and knowing
 * "a software firm, at this street address in Bern, reachable at this email".
 *
 * **Every value is read from `site.js`.** Typing the address here as well would create a
 * second copy to keep in step with the imprint, and the one that drifts is always the copy
 * nobody looks at.
 *
 * **No `priceRange`.** Google likes it on a LocalBusiness, and §2 of CLAUDE.md says there
 * are no prices on this site until Gianni decides what they are. A band invented to satisfy
 * a validator would be a number he then has to honour.
 */
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#organisation', Astro.site).href,
  name: SITE.name,
  url: new URL('/', Astro.site).href,
  email: SITE.email,
  image: ogImage.href,
  description: SITE.description,
  founder: { '@type': 'Person', name: SITE.person },
  knowsLanguage: ['de-CH', 'en', 'sq'],
  areaServed: { '@type': 'Place', name: 'Worldwide' },
  ...(SITE.address && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      postalCode: SITE.address.postcode,
      addressLocality: SITE.address.town,
      addressCountry: 'CH',
    },
  }),
  ...(SITE.uid && { vatID: SITE.uid }),
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map(([code, href]) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0][1]} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_US'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* `SITE.country` is stored in English because it is one value serving both languages;
        the alt text is read aloud to somebody on the German page, so it gets the German. */}
    <meta property="og:image:alt"
          content={`${SITE.name} — ${SITE.city}, ${lang === 'de' ? 'Schweiz' : SITE.country}`} />

    {/* Without this the link is shared as a small square thumbnail beside the text. The
        card is 1200×630 either way; `summary_large_image` is what makes it the picture
        rather than an icon. */}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
  </head>
  <body>
    <slot />
  </body>
</html>
