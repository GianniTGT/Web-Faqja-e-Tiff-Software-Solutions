---
import Page from '../layouts/Page.astro';
import { SITE } from '../data/site.js';

/**
 * Services.
 *
 * **Every entry says when it is the wrong answer**, which is unusual on a page whose job
 * is to sell. It is here on purpose: a studio that tells you not to buy something is the
 * one you believe when it says you should. It also filters the enquiries — the ones that
 * arrive already know what they are asking for.
 */
const services = [
  {
    id: 'desktop',
    eyebrow: 'Desktop software',
    title: 'The system the business actually runs on.',
    body: [
      'A Windows application that holds your real records: stock, costs, customers, ' +
      'documents. It lives on your machine, its database is encrypted, and it opens ' +
      'whether or not the internet does.',
      'That last part is not a technical detail. A business whose till stops when the ' +
      'line drops is a business that has bought somebody else’s uptime.',
    ],
    gets: [
      'An installer, and an application that updates from one link',
      'An encrypted local database, with backups you can verify',
      'Roles — who may see cost and profit, enforced in the data, not hidden in the screen',
      'The documents you print, generated from the record instead of retyped',
    ],
    not:
      'If two or three people need the same live view from different buildings, a web ' +
      'application is the right shape and I will say so.',
  },
  {
    id: 'web',
    eyebrow: 'Websites',
    title: 'Hand-built, fast, and yours.',
    body: [
      'Marketing sites, catalogues and WordPress themes written from scratch — not a ' +
      'page builder, not a stack of plugins that each want a subscription.',
      'The result is a site that loads quickly on a phone on a bad connection, that ' +
      'works with JavaScript switched off, and that nobody can break by updating a ' +
      'plugin you have never heard of.',
    ],
    gets: [
      'A design made for your business, not a template with your logo dropped in',
      'Search, filters and forms that are real links — every result can be sent to somebody',
      'Enquiries stored before any email is attempted, so a mail problem never loses a customer',
      'Written so your own people can edit the words without calling me',
    ],
    not:
      'If you need a shop with a hundred products, stock levels and payments, that is a ' +
      'different job with a different budget. Worth saying before we start, not after.',
  },
  {
    id: 'product',
    eyebrow: 'Products & SaaS',
    title: 'Software built once, sold many times.',
    body: [
      'Some systems are worth turning into a product. Tiff Cardealer began as one ' +
      'dealership’s office system and is now sold to others — the same application, with ' +
      'nothing about the first customer written into it.',
      'That takes a particular discipline from day one: no name, no address, no logo ' +
      'anywhere in the code. If you think what you are building might one day be sold to ' +
      'the business down the road, this is the conversation to have at the start.',
    ],
    gets: [
      'An architecture that separates the product from the customer using it',
      'Per-customer branding, settings and documents with no code change',
      'A build pipeline that produces a signed, downloadable release on every merge',
      'Licensing that does not make your uptime your customer’s problem',
    ],
    not:
      'Most business software should stay one business’s tool. Productising early costs ' +
      'real money and buys nothing until there is a second customer.',
  },
  {
    id: 'care',
    eyebrow: 'Everything around it',
    title: 'Domains, hosting, email — and someone who answers.',
    body: [
      'The unglamorous half. Domains and DNS, hosting that suits where your customers ' +
      'actually are, TLS certificates that renew themselves, business email, backups that ' +
      'live somewhere other than the server they are protecting.',
      'None of it is interesting until it fails, which is the argument for having it set ' +
      'up by the person who will pick up the phone when it does.',
    ],
    gets: [
      'Migrations done on a quiet day, with a backup taken first and kept off the server',
      'Certificates that renew on their own, and a check that they did',
      'Analytics and a privacy policy that match what the site actually collects',
      'A written record of every decision, so the next person is not guessing',
    ],
    not:
      'I do not resell hosting. You own the accounts, you hold the invoices, and you can ' +
      'take them anywhere at any time.',
  },
];
---
<Page
  title={`Services — ${SITE.name}`}
  description="Desktop software, websites, product work and the hosting around them. What each one is, what you get, and when it is the wrong answer."
>
  <section class="head">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1>Four kinds of work.</h1>
      <p class="lede">
        Each of these says what you get and when it is the wrong answer. Both halves are
        useful before you spend anything.
      </p>
    </div>
  </section>

  <div class="wrap toc-wrap">
    <nav class="toc" aria-label="On this page">
      {services.map((s) => <a href={`#${s.id}`}>{s.eyebrow}</a>)}
    </nav>
  </div>

  {services.map((s, i) => (
    <section class="section svc" id={s.id}>
      <div class="wrap layout">
        <div class="copy">
          <p class="eyebrow">{s.eyebrow}</p>
          <h2>{s.title}</h2>
          <div class="prose">
            {s.body.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <div class="detail">
          <div class="card">
            <h3>What you get</h3>
            <ul>{s.gets.map((g) => <li>{g}</li>)}</ul>
          </div>
          <p class="not"><strong>When it is not the answer.</strong> {s.not}</p>
        </div>
      </div>
      {i < services.length - 1 && <div class="wrap"><hr /></div>}
    </section>
  ))}

  <section class="section-tight">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>Not sure which of those it is?</h2>
          <p class="lede">
            That is normal, and working it out is part of the job rather than something to
            settle before you get in touch.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact/">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .head {
    padding-block: clamp(48px, 8vw, 88px) clamp(24px, 3vw, 34px);
    background:
      radial-gradient(110% 80% at 8% -10%,
        color-mix(in srgb, var(--forest) 9%, transparent), transparent 60%),
      var(--paper);
  }
  .head h1 { max-width: 14ch; }

  /* A jump list, not a sticky sidebar: four anchors do not earn a column of their own, and
     a sticky column on a phone is a column in the way. */
  .toc-wrap { padding-top: 20px; }
  .toc { display: flex; flex-wrap: wrap; gap: 10px; }
  .toc a {
    font-family: var(--display);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 999px;
    padding: 7px 15px;
  }
  .toc a:hover { color: var(--forest); border-color: var(--forest); }

  /* A sticky header would otherwise sit on top of the heading an anchor jumps to. */
  .svc { scroll-margin-top: 84px; }

  .layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 44px;
    align-items: start;
  }

  .detail .card ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 11px;
  }
  .detail .card li {
    position: relative;
    padding-left: 24px;
    font-size: 16px;
    color: var(--ink);
    text-wrap: pretty;
  }
  .detail .card li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 10px;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--gold);
  }

  .not {
    margin: 18px 0 0;
    font-size: 15.5px;
    color: var(--muted);
    border-left: 3px solid var(--line);
    padding-left: 16px;
    text-wrap: pretty;
  }
  .not strong { color: var(--ink); font-weight: 600; }

  hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin: clamp(40px, 6vw, 72px) 0 0;
  }

  .band {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(28px, 4vw, 44px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
  }
  .band h2 { margin-bottom: 10px; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: 26px; }
  }
</style>
