---
import Page from '../layouts/Page.astro';
import { SITE } from '../data/site.js';

/**
 * Contact.
 *
 * **There is no form, and that is a decision rather than an omission.** This site is
 * static — there is no server here to receive a POST — so a form would mean handing the
 * enquiries to a third-party service, which for a business whose whole argument is that
 * your data stays yours would be an odd first impression. An email link goes straight to a
 * mailbox nobody else reads.
 *
 * If a form is ever wanted, the honest options are a small handler on the Netcup account
 * or a self-hosted endpoint — not a free tier that reads the messages. See CLAUDE.md §8.
 *
 * **No promised response time here.** One that gets broken on a busy week is worse than
 * none at all; Gianni can add one the day he wants to stand behind it.
 */
const subject = encodeURIComponent('Project enquiry');
const mailto = `mailto:${SITE.email}?subject=${subject}`;

const helps = [
  'What the business does, and who is going to use the thing',
  'What happens today — the spreadsheet, the paper, the double typing',
  'Roughly when you would like it working',
  'Anything already in place that has to keep working',
];
---
<Page
  title={`Contact — ${SITE.name}`}
  description={`Get in touch with ${SITE.name} in ${SITE.city}, ${SITE.country}. Email ${SITE.email}.`}
>
  <section class="head">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Write to me.</h1>
      <p class="lede">
        No form, no sales sequence, nobody else reading it. Tell me what the business does
        and what is getting in the way — that is enough to start with.
      </p>

      <a class="mail" href={mailto}>
        <span class="mail-label">Email</span>
        <span class="mail-value">{SITE.email}</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap layout">
      <div>
        <p class="eyebrow">Before you write</p>
        <h2>What helps me answer properly.</h2>
        <ul class="ticks">{helps.map((h) => <li>{h}</li>)}</ul>
        <p class="quiet small">
          None of it is required. A sentence and a phone number is a perfectly good first
          email — I would rather hear from you with too little than not at all.
        </p>
      </div>

      <div class="card next">
        <h3>What happens then</h3>
        <ol>
          <li>I read it and reply myself. Every one.</li>
          <li>If it looks like a fit, we talk — a call, in whichever language suits you.</li>
          <li>You get a written proposal: what gets built, what it costs, and by when.</li>
          <li>Nothing starts, and nothing is charged, until you have agreed to that.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>Already know what you need?</h2>
          <p class="lede">
            Say so in the first line and skip the rest. The proposal comes faster.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href={mailto}>{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .head {
    padding-block: clamp(48px, 8vw, 88px) clamp(28px, 4vw, 44px);
    background:
      radial-gradient(110% 80% at 8% -10%,
        color-mix(in srgb, var(--forest) 9%, transparent), transparent 60%),
      var(--paper);
  }
  .head h1 { max-width: 12ch; }

  .mail {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 34px;
    padding: 18px 26px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--gold);
    border-radius: var(--r);
    text-decoration: none;
    max-width: 100%;
  }
  .mail:hover { border-color: var(--forest); border-left-color: var(--gold); }
  .mail-label {
    font-family: var(--display);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* A long address on a narrow phone must wrap rather than push the page sideways. */
  .mail-value {
    font-family: var(--mono);
    font-size: clamp(16px, 4.4vw, 21px);
    font-weight: 500;
    color: var(--ink);
    word-break: break-all;
  }

  .layout { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 44px; align-items: start; }

  .ticks { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 12px; }
  .ticks li {
    position: relative;
    padding-left: 26px;
    font-size: 16.5px;
    color: var(--ink);
    text-wrap: pretty;
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 9px;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--gold);
  }
  .small { font-size: 15.5px; margin-top: 22px; max-width: 52ch; }
  .quiet { color: var(--muted); text-wrap: pretty; }

  .next ol { margin: 14px 0 0; padding-left: 20px; display: grid; gap: 11px; }
  .next li { font-size: 16px; color: var(--ink); text-wrap: pretty; }
  .next li::marker { color: var(--gold); font-weight: 600; }

  .band {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(28px, 4vw, 44px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
  }
  .band h2 { margin-bottom: 10px; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: 30px; }
  }
</style>
