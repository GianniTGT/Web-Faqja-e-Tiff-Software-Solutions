---
import Page from '../layouts/Page.astro';
import { SITE } from '../data/site.js';

/**
 * Imprint (Impressum).
 *
 * Not decoration. A business site in Switzerland is expected to identify who is behind it,
 * and in the DACH region its absence is the first thing a prospective client notices.
 *
 * **The page states when it is incomplete rather than hiding it.** With no address in
 * `site.js` it renders a visible notice instead of a tidy gap — the same reasoning as a
 * missing translation key rendering the key: a blank space hides the mistake, and this is
 * the one page where a gap is a legal problem rather than a cosmetic one.
 */
const a = SITE.address;
---
<Page
  title={`Imprint — ${SITE.name}`}
  description={`Who is behind ${SITE.name}: ${SITE.person}, ${SITE.city}, ${SITE.country}.`}
>
  <section class="wrap page">
    <p class="eyebrow">Imprint</p>
    <h1>Who is behind this site.</h1>

    {!a && (
      <p class="unfinished">
        <strong>This page is not finished.</strong> The registered postal address is
        missing. It must be filled in before this site goes live — one entry in
        <code>src/data/site.js</code>.
      </p>
    )}

    <div class="prose block">
      <h2>Responsible for the content</h2>
      <p>
        {SITE.name}<br />
        {SITE.person}<br />
        {a && <>{a.street}<br />{a.postcode} {a.town}<br />{a.country}</>}
        {!a && <em class="todo">— address to be added —</em>}
      </p>

      <h2>Contact</h2>
      <p>
        Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
        <span class="quiet">
          Written enquiries are answered by email. There is no telephone number published
          here yet.
        </span>
      </p>

      {SITE.uid && (
        <>
          <h2>Commercial register</h2>
          <p>{SITE.uid}</p>
        </>
      )}

      <h2>Liability for content</h2>
      <p>
        The content of this site is prepared with care, but no guarantee is given for its
        accuracy, completeness or timeliness. Descriptions of past work are accounts of
        what was built, not promises of what any future project will contain.
      </p>

      <h2>Liability for links</h2>
      <p>
        This site links to a small number of external pages. Their content is the
        responsibility of their operators, and it was not unlawful at the time the link was
        made. Links are removed if that changes and it is brought to my attention.
      </p>

      <h2>Copyright</h2>
      <p>
        The text, design and code of this site are the work of {SITE.person}. Reuse beyond
        what copyright permits needs written agreement — which is usually given for the
        asking.
      </p>

      <h2>Your data</h2>
      <p class="quiet">
        What this site collects, and what it does not, is on the
        <a href="/privacy/">privacy page</a>. It is short, because the answer is mostly
        “nothing”.
      </p>
    </div>
  </section>
</Page>

<style>
  .page { padding-block: clamp(48px, 8vw, 88px) 0; }
  .block { margin-top: 34px; }
  .block h2 { font-size: 20px; margin: 34px 0 10px; }
  .block h2:first-child { margin-top: 0; }
  .quiet { color: var(--muted); }
  .todo { color: var(--muted); font-style: italic; }
  code {
    font-family: var(--mono);
    font-size: 0.92em;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 6px;
  }

  /* Loud on purpose. This is a reminder that has to survive somebody skim-reading. */
  .unfinished {
    margin: 28px 0 0;
    max-width: 68ch;
    padding: 16px 20px;
    border-radius: var(--r);
    border: 1px solid var(--gold);
    background: color-mix(in srgb, var(--gold) 12%, var(--surface));
    color: var(--ink);
    font-size: 16px;
  }
  .unfinished strong { font-weight: 600; }
  .unfinished code { background: color-mix(in srgb, var(--gold) 8%, var(--surface)); }
</style>
